              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=OYPoAbJLHiz7Muy1gScrhWl6L%2B8tBN0GCjFHliMC17BpjEaJ8J8tdueYj82WRltEu4tDTOo%2FkwrK4pSJ4ul706xF8O268dzoMbnZa7wKUSE7l6uQBB5ehehZuXQ%2BghzPMt0SpA%2FJ\"}]}"
